<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cameron McVeigh | Engineering Portfolio</title>
    <style>
      :root { font-family: system-ui, Arial, sans-serif; }
 
      /* ── CHANGE: warm off-white page background instead of plain white ── */
      body { margin: 0; padding: 0; background: #f8f7f5; color: #1a1a1a; }
 
      main { max-width: 900px; margin: 0 auto; padding: 32px 20px 64px; }
 
      /* ── Navigation ── */
      nav {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 48px;
      }
 
      /* ── CHANGE: name brand added beside hamburger ── */
      .nav-brand {
        font-size: 15px;
        font-weight: 500;
        color: #1a1a1a;
        letter-spacing: 0.01em;
      }
 
      .nav-spacer { flex: 1; }
 
      /* ── CHANGE: inline nav links shown on wider screens ── */
      .nav-links {
        display: flex;
        gap: 24px;
      }
 
      .nav-links a {
        font-size: 14px;
        color: #666;
        text-decoration: none;
      }
 
      .nav-links a:hover { color: #1a1a1a; }
 
      /* Dropdown Container */
      .dropdown {
        position: relative;
        display: inline-block;
      }
 
      .dropdown-toggle {
        background: none;
        border: 0.5px solid #ddd;
        padding: 9px 11px;
        border-radius: 8px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s, border-color 0.2s;
      }
 
      .dropdown-toggle:hover {
        background-color: #f2f0ed;
        border-color: #bbb;
      }
 
      .hamburger {
        display: flex;
        flex-direction: column;
        gap: 4px;
        width: 18px;
      }
 
      .hamburger span {
        display: block;
        width: 100%;
        height: 1.5px;
        background-color: #555;
        border-radius: 2px;
        transition: transform 0.2s, opacity 0.2s;
      }
 
      .dropdown.active .hamburger span:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
      .dropdown.active .hamburger span:nth-child(2) { opacity: 0; }
      .dropdown.active .hamburger span:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }
 
      .dropdown-menu {
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        background: white;
        border: 0.5px solid #e0ddd8;
        border-radius: 10px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.08);
        min-width: 160px;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-6px);
        transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
        z-index: 1000;
      }
 
      .dropdown.active .dropdown-menu {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }
 
      .dropdown-menu a {
        display: block;
        padding: 11px 16px;
        color: #333;
        text-decoration: none;
        font-size: 0.9em;
        transition: background-color 0.15s;
      }
 
      .dropdown-menu a:first-child { border-radius: 10px 10px 0 0; }
      .dropdown-menu a:last-child  { border-radius: 0 0 10px 10px; }
      .dropdown-menu a:hover { background-color: #f5f3f0; }
 
      /* ── CHANGE: Hero on a white card with avatar and accent underline ── */
      .hero {
        text-align: center;
        margin-bottom: 56px;
        padding: 48px 24px 40px;
        background: white;
        border-radius: 16px;
        border: 0.5px solid #e8e5e0;
      }
 
      /* ── CHANGE: monogram avatar circle ── */
      .hero-avatar {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #1a1a1a;
        color: white;
        font-size: 22px;
        font-weight: 500;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        letter-spacing: 0.02em;
      }
 
      .hero h1 {
        font-size: 2.2em;
        font-weight: 600;
        margin: 0 0 4px 0;
        color: #1a1a1a;
        display: inline-block;
        position: relative;
      }
 
      /* ── CHANGE: gold accent underline on name ── */
      .hero h1::after {
        content: '';
        display: block;
        width: 48px;
        height: 3px;
        background: #c8a96e;
        border-radius: 2px;
        margin: 8px auto 0;
      }
 
      .hero .role {
        font-size: 1.05em;
        color: #555;
        margin-top: 16px;
        margin-bottom: 4px;
      }
 
      .hero .tagline {
        font-size: 0.95em;
        color: #999;
      }
 
      .about-link { margin-top: 20px; }
 
      .about-link a {
        color: #1a1a1a;
        text-decoration: none;
        font-size: 0.9em;
        border-bottom: 1px solid #ddd;
        padding-bottom: 1px;
      }
 
      .about-link a:hover { border-color: #1a1a1a; }
 
      /* ── Projects Section ── */
      .projects-section { margin-top: 8px; }
 
      /* ── CHANGE: left rule accent on section heading ── */
      .section-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 28px;
      }
 
      .section-rule {
        width: 4px;
        height: 28px;
        background: #1a1a1a;
        border-radius: 2px;
        flex-shrink: 0;
      }
 
      .section-header h2 {
        font-size: 1.6em;
        font-weight: 600;
        color: #1a1a1a;
        margin: 0;
      }
 
      .projects-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
        margin-bottom: 28px;
      }
 
      @media (min-width: 600px) {
        .projects-grid { grid-template-columns: repeat(2, 1fr); }
      }
 
      @media (min-width: 900px) {
        .projects-grid { grid-template-columns: repeat(3, 1fr); }
      }
 
      /* ── CHANGE: white cards on warm bg, coloured top accent per card ── */
      .project-card {
        border: 0.5px solid #e8e5e0;
        border-radius: 14px;
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
        background: white;
        text-decoration: none;
        color: inherit;
        display: block;
      }
 
      .project-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.07);
      }
 
      /* ── CHANGE: coloured accent stripe at top of each card ── */
      .card-accent { height: 4px; }
      .card-accent.blue  { background: #b5c9e8; }
      .card-accent.gold  { background: #c8a96e; }
      .card-accent.teal  { background: #9fcec0; }
 
      .project-image {
        width: 100%;
        height: 180px;
        background: #f5f4f2;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }
 
      .project-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
 
      .project-card:first-child .project-image img { object-position: center top; }
 
      .project-content { padding: 18px 20px 20px; }
 
      .project-content h3 {
        margin: 0 0 10px 0;
        font-size: 1.05em;
        font-weight: 600;
        color: #1a1a1a;
      }
 
      .project-content p {
        margin: 0 0 14px 0;
        color: #666;
        line-height: 1.55;
        font-size: 0.88em;
      }
 
      .project-tags { display: flex; gap: 6px; flex-wrap: wrap; }
 
      /* ── CHANGE: colour-coded tags per project ── */
      .tag {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.78em;
        font-weight: 500;
      }
 
      .tag.blue { background: #e8eef5; color: #2c5282; }
      .tag.gold { background: #faf3e6; color: #7a5a1e; }
      .tag.teal { background: #e8f4f1; color: #1d5c50; }
 
      /* ── CHANGE: darker, more solid CTA button ── */
      .view-all { text-align: center; margin-top: 8px; }
 
      .view-all-link {
        display: inline-block;
        padding: 12px 36px;
        background: #1a1a1a;
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 500;
        font-size: 0.9em;
        letter-spacing: 0.02em;
        transition: background-color 0.2s;
      }
 
      .view-all-link:hover { background: #333; }
 
      /* ── CHANGE: footer added ── */
      footer {
        margin-top: 64px;
        padding-top: 28px;
        border-top: 0.5px solid #e0ddd8;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
      }
 
      footer .footer-left { font-size: 13px; color: #999; }
 
      footer .footer-links { display: flex; gap: 20px; }
 
      footer .footer-links a {
        font-size: 13px;
        color: #666;
        text-decoration: none;
      }
 
      footer .footer-links a:hover { color: #1a1a1a; }
    </style>
  </head>
  <body>
    <main>
      <nav>
        <div class="dropdown" id="pagesDropdown">
          <button class="dropdown-toggle" aria-expanded="false" aria-haspopup="true" aria-label="Navigation menu">
            <span class="hamburger">
              <span></span>
              <span></span>
              <span></span>
            </span>
          </button>
          <div class="dropdown-menu" role="menu">
            <a href="/" role="menuitem">Home</a>
            <a href="/projects/" role="menuitem">Projects</a>
            <a href="/about/" role="menuitem">About</a>
            <a href="/contact/" role="menuitem">Contact</a>
          </div>
        </div>
        <!-- CHANGE: name brand beside hamburger -->
        <span class="nav-brand">Cameron McVeigh</span>
        <div class="nav-spacer"></div>
        <!-- CHANGE: inline nav links -->
        <nav class="nav-links" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/projects/">Projects</a>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
        </nav>
      </nav>
 
      <!-- CHANGE: hero on white card with avatar -->
      <section class="hero">
        <div class="hero-avatar" aria-hidden="true">CM</div>
        <h1>Cameron McVeigh</h1>
        <p class="role">MEng Mechanical Engineering · Robotics Engineer</p>
        <p class="tagline">Dedicated to providing high quality engineering solutions</p>
        <p class="about-link"><a href="/about/">Learn more about me →</a></p>
      </section>
 
      <section class="projects-section">
        <!-- CHANGE: section heading with left rule -->
        <div class="section-header">
          <div class="section-rule"></div>
          <h2>Featured Projects</h2>
        </div>
 
        <div class="projects-grid">
          <!-- CHANGE: blue accent stripe + blue tags -->
          <a href="/projects/project-1/" class="project-card">
            <div class="card-accent blue"></div>
            <div class="project-image">
              <img src="/images/projects/project-1/Image-1.svg" alt="Air/Oil Separator" />
            </div>
            <div class="project-content">
              <h3>Air/Oil Separator</h3>
              <p>Design and build of a cyclonic Air/Oil separator in collaboration with Rolls-Royce UTC.</p>
              <div class="project-tags">
                <span class="tag blue">CAD</span>
                <span class="tag blue">Manufacturing</span>
                <span class="tag blue">Testing</span>
              </div>
            </div>
          </a>
 
          <!-- CHANGE: gold accent stripe + gold tags -->
          <a href="/projects/project-2/" class="project-card">
            <div class="card-accent gold"></div>
            <div class="project-image">
              <img src="/images/projects/project-2/Clutch1.jpg" alt="Centrifugal Clutch" />
            </div>
            <div class="project-content">
              <h3>Centrifugal Clutch</h3>
              <p>Design and build of a centrifugal clutch with detailed mechanical analysis and prototype testing.</p>
              <div class="project-tags">
                <span class="tag gold">CAD</span>
                <span class="tag gold">Design</span>
                <span class="tag gold">Prototyping</span>
              </div>
            </div>
          </a>
 
          <!-- CHANGE: teal accent stripe + teal tags -->
          <a href="/projects/project-3/" class="project-card">
            <div class="card-accent teal"></div>
            <div class="project-image">
              <img src="/images/projects/project-3/vpp-3.jpg" alt="Variable Pitch Propeller" />
            </div>
            <div class="project-content">
              <h3>Variable Pitch Propeller</h3>
              <p>Concept design of a variable pitch propeller following a strict set of design requirements.</p>
              <div class="project-tags">
                <span class="tag teal">CAD</span>
                <span class="tag teal">Analysis</span>
                <span class="tag teal">Design</span>
              </div>
            </div>
          </a>
        </div>
 
        <div class="view-all">
          <a href="/projects/" class="view-all-link">View all projects →</a>
        </div>
      </section>
 
      <!-- CHANGE: footer added -->
      <footer>
        <span class="footer-left">© 2025 Cameron McVeigh</span>
        <div class="footer-links">
          <a href="https://linkedin.com" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://github.com" target="_blank" rel="noopener">GitHub</a>
          <a href="/contact/">Contact</a>
        </div>
      </footer>
    </main>
 
    <script>
      const dropdown = document.getElementById('pagesDropdown');
      const toggle = dropdown.querySelector('.dropdown-toggle');
 
      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const isActive = dropdown.classList.contains('active');
        dropdown.classList.toggle('active');
        toggle.setAttribute('aria-expanded', !isActive);
      });
 
      document.addEventListener('click', (e) => {
        if (!dropdown.contains(e.target)) {
          dropdown.classList.remove('active');
          toggle.setAttribute('aria-expanded', 'false');
        }
      });
 
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && dropdown.classList.contains('active')) {
          dropdown.classList.remove('active');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.focus();
        }
      });
    </script>
  </body>
</html>
 